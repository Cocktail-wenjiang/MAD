.page {
  padding-bottom: 40rpx;
}
.topbar {
  height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.page-title {
  font-size: 38rpx;
  font-weight: 700;
}
.top-action {
  color: #07c160;
  font-size: 28rpx;
}
.notice {
  padding: 24rpx 32rpx;
  color: #777;
  font-size: 25rpx;
}
.profile-strip {
  margin: 0 24rpx 30rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
}
.avatar,
.friend-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #fff;
  background: #07c160;
  text-align: center;
  line-height: 76rpx;
  font-size: 32rpx;
}
.profile-copy {
  flex: 1;
  margin-left: 20rpx;
}
.profile-name {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
}
.profile-meta,
.friend-meta {
  display: block;
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}
.edit-link {
  color: #576b95;
  font-size: 25rpx;
}
.section-label {
  padding: 0 32rpx 18rpx;
  color: #888;
  font-size: 25rpx;
}
.friend-card {
  margin: 0 24rpx 2rpx;
  padding: 26rpx 20rpx;
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.friend-card:first-of-type {
  border-radius: 12rpx 12rpx 0 0;
}
.friend-card:last-child {
  border-radius: 0 0 12rpx 12rpx;
}
.friend-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.friend-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.level-badge {
  padding: 5rpx 10rpx;
  color: #07c160;
  background: #e9f8ef;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 400;
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}
.tag {
  padding: 7rpx 12rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 5rpx;
  font-size: 22rpx;
}
.chevron {
  padding: 18rpx 0 0 12rpx;
  color: #bbb;
  font-size: 42rpx;
  font-weight: 200;
}
