.page {
  min-height: 100vh;
  padding-bottom: 50rpx;
}
.topbar {
  height: 128rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.page-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}
.role-note {
  display: block;
  margin-top: 8rpx;
  color: #929292;
  font-size: 23rpx;
}
.logout {
  color: #576b95;
  font-size: 25rpx;
}
.source {
  margin: 22rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  color: #607067;
  background: #f5faf7;
  font-size: 23rpx;
}
.section-title {
  padding: 30rpx 32rpx 16rpx;
  color: #888;
  font-size: 25rpx;
}
.loading {
  padding: 100rpx 0;
  color: #888;
  text-align: center;
}
.loading-dot {
  margin: 0 auto 18rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #07c160;
  animation: pulse 1s infinite alternate;
}
.history-list {
  margin: 0 24rpx;
}
.history-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff;
}
.history-head {
  display: flex;
  justify-content: space-between;
}
.history-name {
  max-width: 72%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
}
.history-score {
  color: #07c160;
  font-size: 31rpx;
  font-weight: 600;
}
.history-meta {
  display: block;
  margin-top: 9rpx;
  color: #999;
  font-size: 22rpx;
}
.mini-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #666;
  font-size: 22rpx;
}
.mini-row > text:first-child {
  width: 125rpx;
}
.mini-row > text:last-child {
  width: 48rpx;
  text-align: right;
  color: #07c160;
}
.mini-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 8rpx;
  background: #eee;
  overflow: hidden;
}
.mini-bar view {
  height: 100%;
  border-radius: 8rpx;
  background: #07c160;
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}
.tag {
  padding: 7rpx 12rpx;
  border-radius: 5rpx;
  color: #07c160;
  background: #e9f8ef;
  font-size: 22rpx;
}
.detail-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
  z-index: 10;
}
.detail-card {
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 32rpx 52rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.detail-title {
  font-size: 32rpx;
  font-weight: 600;
}
.close {
  color: #999;
  font-size: 48rpx;
  line-height: 1;
}
.detail-avatar {
  margin: 26rpx auto 14rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  line-height: 100rpx;
  text-align: center;
  color: #fff;
  background: #07c160;
  font-size: 42rpx;
}
.detail-name {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}
.detail-line {
  display: block;
  margin-top: 18rpx;
  color: #666;
  font-size: 26rpx;
}
@keyframes pulse {
  from {
    opacity: 0.35;
  }
  to {
    opacity: 1;
  }
}
