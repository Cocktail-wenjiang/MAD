<view class="page">
  <view class="topbar"><text class="page-title">自测</text></view>
  <view class="intro">
    <text class="text">上传高远球或步法短视频，获取能力标签和训练建议。</text>
  </view>
  <view wx:if="{{status === 'idle' || status === 'error'}}">
    <video-upload-card
      title="选择练习视频"
      hint="MP4 格式 · 不超过 60 秒 · 不超过 100MB"
      bindchoose="chooseVideo"
    ></video-upload-card>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view wx:if="{{status === 'processing'}}" class="card">
    <text class="card-title">正在分析 {{videoName}}</text>
    <text class="detail">{{videoMeta}} · 正在提取姿态关键点，请稍候</text>
    <view class="progress"><view class="progress-inner"></view></view>
    <text class="muted">分析通常在 60 秒内返回结果。原视频仅作本次处理，不会保存。</text>
  </view>
  <view wx:if="{{status === 'success'}}" class="card result-card">
    <view class="result-head">
      <text class="card-title">测评结果</text>
      <text wx:if="{{restored}}" class="restored">已从本地缓存恢复</text>
    </view>
    <text class="detail">
      {{videoName}} · 综合水平 {{result.level}} · 平均 {{result.scoreAverage}} 分
    </text>
    <view class="source-line">
      <text>结果来源：{{result.sourceLabel}}</text>
      <text>置信度：{{result.confidence}}（{{result.confidenceLabel}}）</text>
    </view>
    <view wx:for="{{result.scores}}" wx:key="name" class="score-row">
      <score-bar label="{{item.name}}" value="{{item.value}}"></score-bar>
      <text class="issue">{{item.issue}}</text>
      <text class="evidence">依据：{{item.evidence}}</text>
    </view>
    <view class="tag-list">
      <text wx:for="{{result.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <advice-card title="训练建议" text="{{result.advice}}"></advice-card>
    <view class="basis-wrap">{{result.basis}}</view>
    <view class="limit-list">
      <text class="limit-title">使用边界</text>
      <text wx:for="{{result.limitations}}" wx:key="*this" class="limit">{{item}}</text>
    </view>
    <text class="disclaimer">测评仅供训练和匹配参考，不作为专业运动诊断。</text>
    <button wx:if="{{!result.confirmed}}" class="primary" bindtap="confirmResult">
      确认并保存
    </button>
    <button wx:else class="secondary" bindtap="retry">再测一次</button>
    <button wx:if="{{restored}}" class="text-button" bindtap="clearLastReport">清除最近报告</button>
  </view>
</view>
