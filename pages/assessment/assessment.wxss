.page { padding-bottom: 40rpx; }.topbar { height: 112rpx; padding: 0 32rpx; display: flex; align-items: center; background: #fff; border-bottom: 1rpx solid #eee; }.page-title { font-size: 38rpx; font-weight: 700; }.intro { padding: 28rpx 32rpx 20rpx; }.text, .detail, .muted { display: block; margin-top: 12rpx; color: #777; line-height: 1.65; }.card { margin: 0 24rpx; padding: 32rpx; background: #fff; border-radius: 12rpx; }.upload-card { text-align: center; }.upload-icon { display: block; margin: 10rpx auto 18rpx; width: 84rpx; height: 84rpx; color: #07c160; background: #e9f8ef; border-radius: 50%; line-height: 84rpx; font-size: 48rpx; }.card-title { display: block; font-size: 34rpx; font-weight: 700; }.primary, .secondary { margin-top: 30rpx; height: 88rpx; line-height: 88rpx; border-radius: 8rpx; }.primary { background: #07c160; color: #fff; }.secondary { color: #07c160; background: #fff; border: 1rpx solid #07c160; }.error { margin-top: 20rpx; color: #fa5151; font-size: 25rpx; }.progress { height: 12rpx; margin-top: 34rpx; background: #eee; border-radius: 9rpx; overflow: hidden; }.progress-inner { height: 100%; width: 65%; background: #07c160; animation: progress 1.4s ease-in-out infinite alternate; }.result-head { display: flex; justify-content: space-between; align-items: center; }.restored, .source-line, .evidence, .limit, .limit-title { display: block; }.restored { color: #07c160; font-size: 22rpx; }.source-line { margin-top: 16rpx; padding: 16rpx; color: #607067; background: #f5faf7; border-radius: 8rpx; font-size: 23rpx; line-height: 1.7; }.score-row { margin-top: 28rpx; }.score-head { display: flex; justify-content: space-between; }.score-value { color: #07c160; }.bar, .bar-inner { height: 10rpx; border-radius: 8rpx; }.bar { margin-top: 10rpx; background: #eee; }.bar-inner { background: #07c160; }.issue { display: block; margin-top: 10rpx; color: #666; font-size: 25rpx; }.evidence { margin-top: 8rpx; color: #888; font-size: 22rpx; line-height: 1.5; }.tag-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 26rpx; }.tag { padding: 8rpx 14rpx; color: #07c160; background: #e9f8ef; border-radius: 5rpx; font-size: 23rpx; }.advice { margin-top: 28rpx; padding: 22rpx; background: #f7f7f7; border-radius: 8rpx; }.advice-title, .advice-text, .basis { display: block; }.advice-title { font-weight: 600; }.advice-text { margin-top: 12rpx; line-height: 1.6; }.basis { margin-top: 14rpx; color: #888; font-size: 23rpx; line-height: 1.5; }.limit-list { margin-top: 24rpx; padding: 20rpx; background: #fff9e6; border-radius: 8rpx; }.limit-title { color: #8a6d1d; font-weight: 600; }.limit { margin-top: 8rpx; color: #806b2b; font-size: 22rpx; line-height: 1.5; }.disclaimer { display: block; margin-top: 20rpx; color: #999; font-size: 22rpx; }.text-button { margin-top: 18rpx; color: #576b95; background: transparent; font-size: 24rpx; }@keyframes progress { from { width: 35%; } to { width: 80%; } }
