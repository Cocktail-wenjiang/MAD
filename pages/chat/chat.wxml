<view class="page">
  <view class="topbar">
    <text wx:if="{{active}}" class="back-action" bindtap="backToList">‹</text>
    <text class="page-title">{{active ? active.nickname : '聊天'}}</text>
  </view>
  <view wx:if="{{!active}}" class="session-list">
    <view
      wx:for="{{sessions}}"
      wx:key="id"
      class="session"
      data-item="{{item}}"
      bindtap="openSession"
    >
      <view class="chat-avatar">{{item.nickname.slice(0, 1)}}</view>
      <view class="session-main">
        <view class="session-head">
          <text class="session-name">{{item.nickname}}</text>
          <text class="session-time">{{item.time}}</text>
        </view>
        <text class="session-preview">{{item.preview}}</text>
      </view>
      <text wx:if="{{item.unread}}" class="unread">{{item.unread}}</text>
    </view>
  </view>
  <view wx:else class="conversation">
    <scroll-view scroll-y class="messages">
      <view wx:for="{{active.messages}}" wx:key="index" class="message {{item.mine ? 'mine' : ''}}">
        <text>{{item.text}}</text>
      </view>
    </scroll-view>
    <view class="composer">
      <input
        value="{{draft}}"
        bindinput="input"
        placeholder="说点什么"
        confirm-type="send"
        bindconfirm="send"
      />
      <button bindtap="send">发送</button>
    </view>
  </view>
</view>
