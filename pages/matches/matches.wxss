.page { padding: 40rpx 32rpx; }
.title { display: block; font-size: 46rpx; font-weight: 700; }
.subtitle { display: block; margin: 16rpx 0 30rpx; color: #607067; line-height: 1.6; }
.card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 22rpx; }
.card-title { display: block; font-size: 34rpx; font-weight: 700; }
.detail, .level { display: block; margin-top: 14rpx; color: #607067; }
.level { color: #0b6e4f; }
