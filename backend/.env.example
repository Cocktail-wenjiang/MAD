# ============================================================
# 复制为 backend/.env，然后填写下面标注为「填写」的值。
# ============================================================
APP_ENV=development
# 【填写】客户端访问本中转站时使用的 Key，不是上游厂商 Key。
BACKEND_API_KEY=在这里填写中转站访问密钥
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=1

# 【填写 URL + Key】OpenAI
OPENAI_API_KEY=在这里填写OpenAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# 【填写 URL + Key】Anthropic
ANTHROPIC_API_KEY=在这里填写ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 【填写 URL + Key】DeepSeek
DEEPSEEK_API_KEY=在这里填写DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 【填写 URL + Key】Kimi / Moonshot
KIMI_API_KEY=在这里填写KIMI_API_KEY
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 【填写 URL + Key】智谱 GLM
ZHIPU_API_KEY=在这里填写ZHIPU_API_KEY
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 【填写 URL + Key】千问 / 阿里云百炼（OpenAI 兼容）
# API Key 在阿里云百炼控制台获取
QWEN_API_KEY=在这里填写QWEN_API_KEY
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# The canonical template is backend/config/.env.example.
